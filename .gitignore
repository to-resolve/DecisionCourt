backend/test-output/
# v2.0 REDESIGN PR-D1 加: Playwright E2E 产物 (截图 / video / trace)
# 见 docs/postmortem/v2.0-redesign-3d-pivot.md (2026-08-23 回退后, 规则保留以防未来重启用)
frontend/test-output/
frontend/test-results/

# Database
*.db
*.sqlite

# Docker
# 上游忽略所有 .dockerignore，但 frontend/.dockerignore 是容器构建必需：
# 它把 pnpm-workspace.yaml 排除出构建上下文，否则容器内 pnpm@9.15.4 见到
# 「只有 allowBuilds、没有 packages 字段」的 workspace 文件会直接报
# "packages field missing or empty" 构建失败。故对 frontend/ 开例外。
.dockerignore
!frontend/.dockerignore
docker-compose.override.yml

# 误入版本的 pnpm 临时文件（frontend/_tmp_<pid>_<hash>）
frontend/_tmp_*

# Agent 本地工作区（memory / 运维脚本，不属于项目代码）
.workbuddy/

# Local secrets backups
*.env.bak
*.env.backup
secrets/

# v1.0.3 PR-B1: promptlab 本地 YAML override (开发者在不改 base.yaml 的前提下
# 临时试调 prompt; git 不追踪, 不污染正式版).
backend/prompts/*.local.yaml

# Agent 内部 spec / 工作区（不属于项目代码）
.trae/

# ZCode CLI session workspace（不属于项目代码）
.zcode/

# docs 内部材料（不暴露给外部贡献者）
# —— 保留:adr / architecture / deployment/CHECKLIST / roadmap / decisioncourt-*.md(架构设计 + README 指向)
# —— 忽略:interview(面试)/ archive(已归档旧计划)/ observability(白盒化案例含生产流程)
# —— 忽略:dev-deploy-workflow(部署流程)/ security-audit(内部审计)/ OBSERVABILITY(可观测内部)/ project-ideas(灵感池)
docs/interview/
docs/archive/
docs/observability/
docs/dev-deploy-workflow.md
docs/security-audit-v0.8.3.md
docs/OBSERVABILITY.md
docs/project-ideas.md
